#!/bin/sh
# Plays Super Adventure Island on Linux through Wine and gamescope, using the
# rea-launcher-sdk play library (sdk/rea-play.sh; see its shell/README.md).
#
#   sai-play             show the settings window, then start the game
#   sai-play --play      start with the saved settings (no window)
#   sai-play stop        end the game session and its private Wine prefix
#   sai-play status      running or idle
#
# Optional environment:
#   SAI_PREFIX    Wine prefix (default ~/.local/share/sai-launcher/prefix)
#   SAI_LAUNCHER  SAILauncher.exe (default: next to this script, or one up)
#   SAI_RUN       a wrapper that runs wine and gamescope, e.g.
#                      "distrobox enter gaming --" when they live in a container
#   SAI_WAIT      set by the AppImage (every launch waits anyway)
#   SAI_GPU       GPU environment to use instead of the detected one
set -u

# --- the library: next to this script in a package, else the vendored copy --
# Tests source this script with REA_FUNCTIONS_ONLY=1 (load, don't run) and
# REA_PLAY_HERE=<this script's folder> ($0 is then the test). REA_PLAY_HERE
# counts only in that mode; the library drops both once sourced.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=sai-play

# --- configuration (after sourcing: inherited REA_* values are dropped, so
# only the player-facing SAI_* names below reach the library) ----------
REA_APP=sai-launcher                 # ~/.config/sai-launcher, the prefix name
REA_EXE_NAME=SAILauncher.exe
REA_EXE_HINT=SAI_LAUNCHER
REA_EXE=${SAI_LAUNCHER:-}
REA_PREFIX=${SAI_PREFIX:-}
REA_RUN=${SAI_RUN:-}
REA_WAIT=${SAI_WAIT:-}
[ -n "${SAI_GPU+set}" ] && REA_GPU=$SAI_GPU   # SAI_GPU= for no GPU choice
REA_CFG_APPDATA=SAILauncher       # AppData\Local\SAILauncher\launcher.cfg
REA_WINEDBG_OFF=1                     # a fault ends the game, no hidden debugger
# What size each look gives gamescope (config.rs Look::picture; keep in step):
REA_LOOK_SIZES="original=original recommended=screen steam_deck=1280x800"
# Game choices to make once the game is known (sdk shell/README.md, "Game
# differences kept as settings"):
#   REA_ORIGINAL_SIZE=640x480         what resolution = original means
#   REA_DLL_OVERRIDES='d3d9=n,b'      the game's WINEDLLOVERRIDES (DXVK, ...)
#   REA_GAME_PROCS='SuperAdventureIsland.exe'       when the launcher returns before the game
#                                     (at most 15 characters per name)

# --- game hooks --------------------------------------------------------------

# Once per prefix: no crash dialog.
rea_hook_before_start() {
  rea_wine_no_crash_dialog
}

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
